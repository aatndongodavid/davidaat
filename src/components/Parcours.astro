---
import { experiences, formations } from '../data/profile';
---
<section id="apropos">
  <div class="fade-in">
    <h2 class="section-title"><span>Parcours</span> & Vision</h2>
    <p class="section-sub">Ingénieur polyvalent, je maîtrise les trois piliers de la tech : Data Science, Intelligence Artificielle et Ingénierie Logicielle / IT.</p>
  </div>
  <div class="timeline fade-in">
    {experiences.map((x) => (
      <div class="timeline-item">
        <div class="timeline-date">{x.date}</div>
        <div class="timeline-title">{x.title}</div>
        <div class="timeline-org">{x.org}</div>
        <div class="timeline-desc">{x.desc}</div>
      </div>
    ))}
  </div>

  <div class="fade-in formations">
    <h3>Formation</h3>
    {formations.map((f) => (
      <div class="glass-card">
        <p class="formation-title"><strong>{f.title}</strong> - {f.school}</p>
        {f.note && <p class="formation-note">{f.note}</p>}
      </div>
    ))}
  </div>
</section>

<style>
  .formations { margin-top: 60px; display: grid; gap: 20px; }
  h3 { font-family: 'Syne', sans-serif; color: var(--primary-light); }
  .formation-title { color: #fff; }
  .formation-note { color: var(--muted); font-size: 0.9rem; }
</style>
