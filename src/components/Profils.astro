---
import { profiles } from '../data/profile';
---
<section id="profils">
  <div class="fade-in">
    <h2 class="section-title"><span>Mes 3 profils</span> d’expertise</h2>
    <p class="section-sub">Trois métiers complémentaires, une même exigence d’excellence.</p>
  </div>
  <div class="profile-grid fade-in">
    {profiles.map((p) => (
      <div class="profile-card">
        <i class={p.icon}></i>
        <h3>{p.title}</h3>
        <p>{p.desc}</p>
      </div>
    ))}
  </div>
</section>
